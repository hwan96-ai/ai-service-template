{
  "templateName": "ai-service-template",
  "templateVersion": "0.6.11",
  "phasesImplemented": [1, 2, 3, 4, 5, 6],
  "description": "Reusable, safety-first local AI automation harness. Coordinates Codex CLI (implementer), Claude Code CLI (reviewer), local tests, and a final human handoff without ever committing, pushing, deploying, or installing dependencies on its own.",
  "requiredFiles": [
    "AI_PRODUCT_SPEC.md",
    "AI_ACCEPTANCE_CRITERIA.md",
    "AI_TASK_QUEUE.md",
    "AI_WORKFLOW.md",
    "AI_AGENT_BOOTSTRAP.md",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "README_KO.md",
    "SECURITY.md",
    "TEMPLATE_USAGE.md",
    "TEMPLATE_CHANGELOG.md",
    "SERVICE_ONBOARDING_CHECKLIST.md",
    "TEMPLATE_MANIFEST.json",
    "assets/hero-banner.svg",
    "assets/workflow-overview.svg"
  ],
  "controlDocuments": [
    "AI_PRODUCT_SPEC.md",
    "AI_ACCEPTANCE_CRITERIA.md",
    "AI_TASK_QUEUE.md",
    "AI_WORKFLOW.md",
    "AI_AGENT_BOOTSTRAP.md",
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "payloadSourceDir": "template-payload",
  "payloadDocuments": [
    "AI_PRODUCT_SPEC.md",
    "AI_ACCEPTANCE_CRITERIA.md",
    "AI_TASK_QUEUE.md",
    "AI_WORKFLOW.md"
  ],
  "toolFiles": [
    "tools/ai-autopilot.ps1",
    "tools/collect-context.ps1",
    "tools/detect-tests.ps1",
    "tools/write-claude-review-prompt.ps1",
    "tools/write-codex-implementation-prompt.ps1",
    "tools/write-codex-fix-prompt.ps1",
    "tools/write-final-handoff.ps1",
    "tools/install-ai-service-template.ps1",
    "tools/copy-template-to-service.ps1",
    "tools/validate-template-install.ps1"
  ],
  "sentinelFiles": [
    "ai-runs/.gitkeep"
  ],
  "neverCopy": [
    ".git",
    ".claude",
    "ai-runs/[0-9]*"
  ],
  "localArtifactPatterns": [
    "ai-runs/*",
    ".claude/"
  ],
  "gitignoreRulesToAppend": [
    "# Local AI run artifacts — generated by tools/ai-autopilot.ps1",
    "ai-runs/*",
    "!ai-runs/.gitkeep",
    "",
    "# Local Claude Code CLI state (per-machine permission settings, session data)",
    ".claude/"
  ],
  "forbiddenByDefault": [
    "git commit",
    "git push",
    "git tag",
    "deploy",
    "npm install",
    "pnpm install",
    "yarn install",
    "pip install",
    "poetry install",
    "uv add",
    "rm -rf",
    "Remove-Item -Recurse",
    "git reset --hard",
    "git clean",
    "AutoCommit",
    "danger-full-access",
    "--dangerously-bypass-approvals-and-sandbox",
    "--full-auto",
    "yolo",
    "bypass",
    "--dangerously-skip-permissions",
    "acceptEdits",
    "bypassPermissions"
  ],
  "recommendedFirstCommands": [
    {
      "order": 1,
      "purpose": "Detection-only smoke run. No tests, no Codex, no Claude.",
      "command": "powershell -ExecutionPolicy Bypass -File .\\tools\\ai-autopilot.ps1 -DryRun -Goal \"service smoke test\""
    },
    {
      "order": 2,
      "purpose": "Run selected unit-level local checks from a trusted repository. No Codex, no Claude.",
      "command": "powershell -ExecutionPolicy Bypass -File .\\tools\\ai-autopilot.ps1 -TestLevel unit -Goal \"unit validation\""
    },
    {
      "order": 3,
      "purpose": "Generate the Codex prompt without invoking Codex CLI.",
      "command": "powershell -ExecutionPolicy Bypass -File .\\tools\\ai-autopilot.ps1 -Implementer codex -DryRun -Goal \"Codex prompt only\""
    },
    {
      "order": 4,
      "purpose": "Generate the Claude review prompt without invoking Claude CLI.",
      "command": "powershell -ExecutionPolicy Bypass -File .\\tools\\ai-autopilot.ps1 -Reviewer claude -DryRun -Goal \"Claude review prompt only\""
    },
    {
      "order": 5,
      "purpose": "One-shot Codex CLI invocation in workspace-write sandbox plus unit tests.",
      "command": "powershell -ExecutionPolicy Bypass -File .\\tools\\ai-autopilot.ps1 -Implementer codex -RunImplementer -TestLevel unit -Goal \"one-shot implementation\""
    },
    {
      "order": 6,
      "purpose": "Bounded Codex <-> Claude fix loop, capped at 2 iterations.",
      "command": "powershell -ExecutionPolicy Bypass -File .\\tools\\ai-autopilot.ps1 -Implementer codex -RunImplementer -Reviewer claude -RunReviewer -EnableFixLoop -MaxIterations 2 -TestLevel unit -Goal \"bounded loop\""
    }
  ],
  "copyScript": "tools/copy-template-to-service.ps1",
  "validationScript": "tools/validate-template-install.ps1",
  "humanApprovalRequired": true,
  "autoCommit": false,
  "autoPush": false,
  "autoDeploy": false
}
